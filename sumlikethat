-- Auto skip settings (kept local to this addon, saved to same file)
local AutoSkipAfterWave = SavedCfg.AutoSkipAfterWave
local AutoSkipWave = SavedCfg.AutoSkipWave
local LastSkipRequest = 0

local lastSaved = {}
local function SnapshotState()
    return {
        Enabled = State.AutoSellLowHp,
        HpThreshold = State.AutoSellLowHpThreshold,
        WaveLimit = State.AutoSellLowHpWaveLimit,
        WindowX = WindowX,
        WindowY = WindowY,
        Minimized = Minimized,
        Closed = Closed,
        AutoSkipAfterWave = AutoSkipAfterWave,
        AutoSkipWave = AutoSkipWave,
    }
end

local function PersistIfChanged()
    local cur = SnapshotState()
    local changed = false
    for k, v in pairs(cur) do
        if lastSaved[k] ~= v then changed = true break end
    end
    if changed then
        lastSaved = cur
        SavePanicConfig(cur)
    end
end

lastSaved = SnapshotState()

-- ============================================================
-- Getters
-- ============================================================
local function GetInfoFolder()
    return Workspace:FindFirstChild("Info")
end

local function GetWave()
    local info = GetInfoFolder()
    local w = info and info:FindFirstChild("Wave")
    return (w and w:IsA("ValueBase") and tonumber(w.Value)) or 0
end

local function IsGameRunning()
    local info = GetInfoFolder()
    local r = info and info:FindFirstChild("GameRunning")
    return r and r:IsA("ValueBase") and r.Value == true
end

local function GetBaseHealthText()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local gg = pg and pg:FindFirstChild("GameGui")
    local info = gg and gg:FindFirstChild("Info")
    local health = info and info:FindFirstChild("Health")
    local title = health and health:FindFirstChild("Title")
    if title and (title:IsA("TextLabel") or title:IsA("TextButton")) then
        return tostring(title.Text or "")
    end
    return "Unknown"
end

local function GetBaseHealthNumber()
    local text = GetBaseHealthText()
    if text == "Unknown" or text == "" then return nil end
    local cleaned = tostring(text):gsub(",", ""):gsub("%s", "")
    local num, suffix = cleaned:match("^([%d%.]+)([KkMmBb]?)")
    num = tonumber(num)
    if not num then return nil end
    local mult = { K = 1e3, M = 1e6, B = 1e9 }
    if suffix and suffix ~= "" then
        num = num * (mult[suffix:upper()] or 1)
    end
    return num
end

-- ============================================================
-- Remote helpers (for skip)
-- ============================================================
local function GetSkipRemote()
    local Functions = ReplicatedStorage:FindFirstChild("Functions")
    return Functions and Functions:FindFirstChild("VoteSkip")
end

local function IsSkipAvailable()
    -- Prefer the game's own UI signal
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local gg = pg and pg:FindFirstChild("GameGui")
    local skipGui = gg and gg:FindFirstChild("WaveSkipGui")
    if skipGui then
        if skipGui:IsA("LayerCollector") then return skipGui.Enabled end
        if skipGui:IsA("GuiObject") then return skipGui.Visible end
    end
    -- Fallback to Info values
    local info = GetInfoFolder()
    local cur = tonumber((info and info:FindFirstChild("VoteSkipValue")
        and info.VoteSkipValue.Value) or 0) or 0
    local need = tonumber((info and info:FindFirstChild("VoteSkipPlrValue")
        and info.VoteSkipPlrValue.Value) or 0) or 0
    return need > 0 and cur < need
end

local function TrySkip()
    local remote = GetSkipRemote()
    if not remote then return false end
    local ok = pcall(remote.InvokeServer, remote)
    return ok
end

-- ============================================================
-- Sell logic
-- ============================================================
local function SellAllOwnTowers()
    local Functions = ReplicatedStorage:FindFirstChild("Functions")
    local SellRemote = Functions and Functions:FindFirstChild("SellTower")
    if not SellRemote then return false, "SellTower remote missing" end

    local towers = Workspace:FindFirstChild("Towers")
    if not towers then return false, "Towers folder missing" end

    local sold, failed = 0, 0
    for _ = 1, 5 do
        local targets = {}
        for _, tower in ipairs(towers:GetChildren()) do
            local config = tower:FindFirstChild("Config")
            local owner = config and config:FindFirstChild("Owner")
            if owner and tostring(owner.Value) == LocalPlayer.Name then
                table.insert(targets, tower)
            end
        end
        if #targets == 0 then break end
        for _, tower in ipairs(targets) do
            if tower.Parent then
                local ok, accepted = pcall(SellRemote.InvokeServer, SellRemote, tower)
                if ok and accepted ~= false then
                    sold = sold + 1
                else
                    failed = failed + 1
                end
                task.wait(0.06)
            end
        end
        task.wait(0.15)
    end
    return true, string.format("Sold %d | Failed %d", sold, failed)
end

local function Notify(title, content)
    pcall(function()
        local WindUI = getgenv().WindUI
        if WindUI and WindUI.Notify then
            WindUI:Notify({ Title = title, Content = content, Duration = 5, Icon = "bell" })
        end
    end)
    print(string.format("[Panic Sell] %s: %s", tostring(title), tostring(content)))
end

-- ============================================================
-- Watchdog — panic sell
-- ============================================================
task.spawn(function()
    while State.Running do
        local active = IsGameRunning() and GetWave() >= 1
        local wave = GetWave()

        local panicActive = active
            and State.AutoSellLowHp
            and wave <= State.AutoSellLowHpWaveLimit

        if panicActive and not State.AutoSellBusy
            and State.AutoSellLowHpTriggeredSerial ~= State.MatchSerial then

            local hp = GetBaseHealthNumber()
            if hp and hp < State.AutoSellLowHpThreshold then
                State.AutoSellLowHpTriggeredSerial = State.MatchSerial
                State.AutoSellBusy = true

                Notify("Panic Sell",
                    string.format("Base HP %d < %d at wave %d",
                        math.floor(hp), State.AutoSellLowHpThreshold, wave))

                local ok, detail = SellAllOwnTowers()
                State.AutoSellBusy = false

                if ok then
                    Notify("Panic Sell complete", detail)
                else
                    Notify("Panic Sell incomplete", detail)
                    if State.Running and IsGameRunning() then
                        State.AutoSellLowHpTriggeredSerial = -1
                    end
                end
            end
        end

        PersistIfChanged()
        task.wait(0.5)
    end
end)

-- ============================================================
-- Watchdog — auto skip after wave
-- ============================================================
task.spawn(function()
    while State.Running do
        if AutoSkipAfterWave and IsGameRunning() and GetWave() >= AutoSkipWave then
            if IsSkipAvailable() and (os.clock() - LastSkipRequest) >= 1.5 then
                LastSkipRequest = os.clock()
                task.spawn(function()
                    local ok = TrySkip()
                    if ok then
                        print(string.format("[Panic Sell] Skip requested at wave %d", GetWave()))
                    end
                end)
            end
        end
        task.wait(0.5)
    end
end)

-- ============================================================
-- Watchdog — reset trigger each match
-- ============================================================
task.spawn(function()
    local lastSerial = State.MatchSerial
    while State.Running do
        if State.MatchSerial ~= lastSerial then
            lastSerial = State.MatchSerial
            State.AutoSellLowHpTriggeredSerial = -1
        end
        task.wait(0.5)
    end
end)

