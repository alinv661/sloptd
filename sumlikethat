-- ============================================================
-- Persistence
-- ============================================================
local CONFIG_FOLDER = "SlopTD_Macros"
local PANIC_CONFIG = CONFIG_FOLDER .. "/PanicSell.json"

local HasFilesystem = type(isfolder) == "function"
    and type(makefolder) == "function"
    and type(isfile) == "function"
    and type(readfile) == "function"
    and type(writefile) == "function"

if HasFilesystem and not isfolder(CONFIG_FOLDER) then
    pcall(makefolder, CONFIG_FOLDER)
end

local Defaults = {
    Enabled = false,
    HpThreshold = 99,
    WaveLimit = 49,
    WindowX = 20,
    WindowY = 200,
    Minimized = false,
    Closed = false,
    -- Auto skip
    AutoSkipAfterWave = false,
    AutoSkipWave = 30,
}

local function LoadPanicConfig()
    if not HasFilesystem or not isfile(PANIC_CONFIG) then
        return table.clone(Defaults)
    end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(PANIC_CONFIG))
    end)
    if not ok or type(decoded) ~= "table" then
        return table.clone(Defaults)
    end
    return {
        Enabled = decoded.Enabled == true,
        HpThreshold = math.clamp(math.floor(tonumber(decoded.HpThreshold) or Defaults.HpThreshold), 1, 99999),
        WaveLimit = math.clamp(math.floor(tonumber(decoded.WaveLimit) or Defaults.WaveLimit), 1, 500),
        WindowX = tonumber(decoded.WindowX) or Defaults.WindowX,
        WindowY = tonumber(decoded.WindowY) or Defaults.WindowY,
        Minimized = decoded.Minimized == true,
        Closed = decoded.Closed == true,
        AutoSkipAfterWave = decoded.AutoSkipAfterWave == true,
        AutoSkipWave = math.clamp(math.floor(tonumber(decoded.AutoSkipWave) or Defaults.AutoSkipWave), 1, 500),
    }
end

local function SavePanicConfig(cfg)
    if not HasFilesystem then return end
    pcall(function()
        writefile(PANIC_CONFIG, HttpService:JSONEncode(cfg))
    end)
end

