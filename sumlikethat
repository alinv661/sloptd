        skipToggle.BackgroundColor3 = AutoSkipAfterWave and Color3.fromRGB(46, 130, 200) or Color3.fromRGB(50, 50, 60)
        PersistIfChanged()
    end)

    -- Skip Wave row
    local skipRow = Instance.new("Frame")
    skipRow.Size = UDim2.new(1, -20, 0, 24)
    skipRow.Position = UDim2.fromOffset(10, 168)
    skipRow.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
    skipRow.BorderSizePixel = 0
    skipRow.Parent = Body

    local skipCorner2 = Instance.new("UICorner")
    skipCorner2.CornerRadius = UDim.new(0, 6)
    skipCorner2.Parent = skipRow

    local skipLabel = Instance.new("TextLabel")
    skipLabel.Size = UDim2.new(0.6, 0, 1, 0)
    skipLabel.Position = UDim2.fromOffset(8, 0)
    skipLabel.BackgroundTransparency = 1
    skipLabel.Text = "Skip After Wave"
    skipLabel.TextColor3 = Color3.fromRGB(200, 200, 210)
    skipLabel.Font = Enum.Font.Gotham
    skipLabel.TextSize = 11
    skipLabel.TextXAlignment = Enum.TextXAlignment.Left
    skipLabel.Parent = skipRow

    local skipValue = Instance.new("TextButton")
    skipValue.Size = UDim2.new(0.4, -8, 1, -4)
    skipValue.Position = UDim2.new(0.6, 0, 0, 2)
    skipValue.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    skipValue.Text = tostring(AutoSkipWave)
    skipValue.TextColor3 = Color3.fromRGB(240, 240, 240)
    skipValue.Font = Enum.Font.GothamSemibold
    skipValue.TextSize = 11
    skipValue.BorderSizePixel = 0
    skipValue.Parent = skipRow

    local skipValCorner = Instance.new("UICorner")
    skipValCorner.CornerRadius = UDim.new(0, 4)
    skipValCorner.Parent = skipValue

    skipValue.MouseButton1Click:Connect(function()
        local presets = { 5, 10, 15, 20, 25, 30, 40, 50, 75, 100, 150 }
        local idx = 1
        for i, v in ipairs(presets) do
            if AutoSkipWave <= v then idx = i break end
        end
        AutoSkipWave = presets[(idx % #presets) + 1]
        skipValue.Text = tostring(AutoSkipWave)
        PersistIfChanged()
    end)

    -- Status line
    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -20, 0, 16)
    status.Position = UDim2.fromOffset(10, 196)
    status.BackgroundTransparency = 1
    status.Text = "Idle"
    status.TextColor3 = Color3.fromRGB(150, 150, 160)
    status.Font = Enum.Font.Gotham
    status.TextSize = 10
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.Parent = Body

    task.spawn(function()
        while status.Parent do
            local active = IsGameRunning() and GetWave() >= 1
            if not active then
                status.Text = "Waiting for match"
                status.TextColor3 = Color3.fromRGB(150, 150, 160)
            else
                local wave = GetWave()
                local parts = {}
                if State.AutoSellLowHp then
                    if wave > State.AutoSellLowHpWaveLimit then
                        table.insert(parts, "sell:past limit")
                    else
                        local hp = GetBaseHealthNumber()
                        if hp then
                            table.insert(parts, string.format("HP %d", math.floor(hp)))
                        end
                    end
                end
                if AutoSkipAfterWave then
                    if wave >= AutoSkipWave then
                        table.insert(parts, "skip:active")
                    else
                        table.insert(parts, string.format("skip@%d", AutoSkipWave))
                    end
                end
                if #parts > 0 then
                    status.Text = "Wave " .. tostring(wave) .. " | " .. table.concat(parts, " | ")
                    status.TextColor3 = Color3.fromRGB(150, 200, 150)
                else
                    status.Text = "Wave " .. tostring(wave) .. " | both off"
                    status.TextColor3 = Color3.fromRGB(150, 150, 160)
                end
            end
            task.wait(0.4)
        end
    end)

    -- Reopen button
    ReopenBtn = Instance.new("TextButton")
    ReopenBtn.Name = "ReopenBtn"
    ReopenBtn.Size = UDim2.fromOffset(90, 28)
    ReopenBtn.Position = UDim2.fromOffset(WindowX, WindowY)
    ReopenBtn.BackgroundColor3 = Color3.fromRGB(46, 180, 92)
    ReopenBtn.Text = "Slop TD Addon"
    ReopenBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ReopenBtn.Font = Enum.Font.GothamSemibold
    ReopenBtn.TextSize = 12
    ReopenBtn.BorderSizePixel = 0
    ReopenBtn.Visible = Closed
    ReopenBtn.Parent = gui

    local reopenCorner = Instance.new("UICorner")
    reopenCorner.CornerRadius = UDim.new(0, 6)
    reopenCorner.Parent = ReopenBtn

    ReopenBtn.MouseButton1Click:Connect(function()
        Closed = false
        UpdateCloseVisual()
        PersistIfChanged()
    end)

    -- Dragging
    local dragging = false
    local dragStart, startPos

    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    WindowX = frame.Position.X.Offset
                    WindowY = frame.Position.Y.Offset
                    PersistIfChanged()
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    local reopenDragging = false
    local reopenDragStart, reopenStartPos

    ReopenBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            reopenDragging = true
            reopenDragStart = input.Position
            reopenStartPos = ReopenBtn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    reopenDragging = false
                    WindowX = ReopenBtn.Position.X.Offset
                    WindowY = ReopenBtn.Position.Y.Offset
                    PersistIfChanged()
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if reopenDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - reopenDragStart
            ReopenBtn.Position = UDim2.new(
                reopenStartPos.X.Scale, reopenStartPos.X.Offset + delta.X,
                reopenStartPos.Y.Scale, reopenStartPos.Y.Offset + delta.Y
            )
        end
    end)

    MinimizeBtn.MouseButton1Click:Connect(function()
        Minimized = not Minimized
        UpdateMinimizeVisual()
        PersistIfChanged()
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        Closed = true
        UpdateCloseVisual()
        PersistIfChanged()
    end)

    local function addHover(btn, baseColor, hoverColor)
        btn.MouseEnter:Connect(function() btn.BackgroundColor3 = hoverColor end)
        btn.MouseLeave:Connect(function() btn.BackgroundColor3 = baseColor end)
    end
    addHover(MinimizeBtn, Color3.fromRGB(50, 50, 60), Color3.fromRGB(70, 70, 85))
    addHover(CloseBtn, Color3.fromRGB(180, 50, 50), Color3.fromRGB(220, 70, 70))
    addHover(ReopenBtn, Color3.fromRGB(46, 180, 92), Color3.fromRGB(60, 200, 110))

    UpdateMinimizeVisual()
    UpdateCloseVisual()

    gui.Parent = pg
end

MakeControlPanel()
QueuePanicOnTeleport()

genv.__PanicSellLoading = false

print("[Panic Sell] Addon v4 loaded. Sections: Panic Sell + Auto Skip.")
