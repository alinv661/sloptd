local function WaitForHub(timeout)
    local deadline = os.clock() + (timeout or 180)
    while os.clock() < deadline do
        local hub = getgenv().SlopTDHub
        if hub and hub.State and type(hub.State) == "table" and hub.State.Running then
            return hub
        end
        task.wait(0.3)
    end
    return nil
end

