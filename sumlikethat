local function GetQueueOnTeleport()
    if type(queue_on_teleport) == "function" then return queue_on_teleport end
    if type(queueonteleport) == "function" then return queueonteleport end
    if type(syn) == "table" and type(syn.queue_on_teleport) == "function" then
        return syn.queue_on_teleport
    end
    if type(fluxus) == "table" and type(fluxus.queue_on_teleport) == "function" then
        return fluxus.queue_on_teleport
    end
    return nil
end

local function QueuePanicOnTeleport()
    local queue = GetQueueOnTeleport()
    if not queue then return false end

    local queuedSource = [[
if not game:IsLoaded() then game.Loaded:Wait() end
task.wait(2)

local boot = getgenv().__SlopTDHubBoot
local hubReady = getgenv().SlopTDHub ~= nil
local hubBooting = boot and boot.Loading == true

if not hubReady and not hubBooting then
    local hubURL = "https://raw.githubusercontent.com/KeroTwT/Kero-Hub/refs/heads/main/Slop%20TD"
    pcall(function()
        local source = game:HttpGet(hubURL)
        local chunk = loadstring(source)
        if chunk then chunk() end
    end)
    task.wait(2)
end

local addonURL = "https://raw.githubusercontent.com/alinv661/sloptd/refs/heads/main/sumlikethat"
pcall(function()
    local source = game:HttpGet(addonURL)
    local chunk = loadstring(source)
    if chunk then chunk() end
end)
]]
    return pcall(queue, queuedSource)
end

